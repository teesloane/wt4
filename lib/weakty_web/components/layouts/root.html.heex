<!DOCTYPE html>
<html lang="en">
  <head>
    <%= Application.get_env(:live_debugger, :live_debugger_tags) %>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Weakty" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:wght@300;400;700&family=IBM+Plex+Serif:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));

        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body>
  <%= if !String.starts_with?(@conn.request_path, "/admin") do %>
    <nav class="border-b border-base-300">
      <div class="max-w-7xl mx-auto px-6 py-6 flex items-center justify-between averia">
        <!-- Logo -->
        <.link navigate={~p"/"} class="font-bold text-sm tracking-widest uppercase">
          WEAKTY
        </.link>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex gap-8 items-center">
          <.link navigate={~p"/archive"} class="text-sm tracking-wide uppercase hover:opacity-60 transition-opacity">
            ARCHIVE
          </.link>
          <.link navigate={~p"/posts"} class="text-sm tracking-wide uppercase hover:opacity-60 transition-opacity">
            WEBRING
          </.link>
          <.link navigate={~p"/links"} class="text-sm tracking-wide uppercase hover:opacity-60 transition-opacity">
            NOW
          </.link>
          <.link navigate={~p"/about"} class="text-sm tracking-wide uppercase hover:opacity-60 transition-opacity">
            ABOUT
          </.link>
          <button class="btn btn-ghost btn-sm btn-circle" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
          </button>
        </div>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-button"
          class="md:hidden btn btn-ghost btn-sm btn-square"
          aria-label="Open menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-5 h-5 stroke-current">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </nav>
    <% end %>

    <!-- Mobile Menu Drawer -->
    <div id="mobile-menu" class="fixed inset-0 z-50 hidden">
      <!-- Backdrop -->
      <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/50"></div>

      <!-- Drawer -->
      <div id="mobile-menu-drawer" class="absolute right-0 top-0 bottom-0 w-64 bg-base-100 shadow-xl transform translate-x-full transition-transform duration-300">
        <div class="flex flex-col h-full">
          <!-- Header -->
          <div class="flex items-center justify-between p-4 border-b border-base-300">
            <span class="font-bold text-lg">Menu</span>
            <button id="mobile-menu-close" class="btn btn-ghost btn-sm btn-square">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-5 h-5 stroke-current">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <!-- Navigation Links -->
          <div class="flex flex-col p-4 space-y-4">
            <.link navigate={~p"/archive"} class="text-sm tracking-wide uppercase hover:opacity-60 transition-opacity py-2">
              ARCHIVE
            </.link>
            <.link navigate={~p"/posts"} class="text-sm tracking-wide uppercase hover:opacity-60 transition-opacity py-2">
              WEBRING
            </.link>
            <.link navigate={~p"/links"} class="text-sm tracking-wide uppercase hover:opacity-60 transition-opacity py-2">
              NOW
            </.link>
            <.link navigate={~p"/about"} class="text-sm tracking-wide uppercase hover:opacity-60 transition-opacity py-2">
              ABOUT
            </.link>
          </div>
        </div>
      </div>
    </div>

    <script>
      // Mobile menu functionality
      (() => {
        const menu = document.getElementById('mobile-menu');
        const drawer = document.getElementById('mobile-menu-drawer');
        const openButton = document.getElementById('mobile-menu-button');
        const closeButton = document.getElementById('mobile-menu-close');
        const backdrop = document.getElementById('mobile-menu-backdrop');

        const openMenu = () => {
          menu.classList.remove('hidden');
          setTimeout(() => drawer.classList.remove('translate-x-full'), 10);
          document.body.style.overflow = 'hidden';
        };

        const closeMenu = () => {
          drawer.classList.add('translate-x-full');
          setTimeout(() => menu.classList.add('hidden'), 300);
          document.body.style.overflow = '';
        };

        openButton?.addEventListener('click', openMenu);
        closeButton?.addEventListener('click', closeMenu);
        backdrop?.addEventListener('click', closeMenu);

        // Close menu on navigation (LiveView navigation)
        document.addEventListener('click', (e) => {
          if (e.target.closest('#mobile-menu-drawer a')) {
            closeMenu();
          }
        });
      })();
    </script>

    {@inner_content}
  </body>
</html>
