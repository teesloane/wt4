<Layouts.flash_group flash={@flash} />

<% section_class = "w-full h-[45vh] p-8 px-12 flex flex-col justify-center border border-base-300" %>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-0 flex flex-col">
  <section class={[section_class, "text-3xl"]}>
  Hello, my name is Ty.
  
  <div class="mt-8 text-content-200">
    This is where I write and share my work.
  </div>
  </section>
  <section class={section_class}>Some things I've made:</section>
  <section class={section_class}>My most recent piece of fiction is: _____</section>
  <section class={section_class}>
    <.home_grid_header> Currently reading: </.home_grid_header>
    <%= @currently_reading.title %>
      <.view_all href={~p"/media-logs?type=book&status=all&year=all"} label="View the media log" />
  </section>

  <section class={section_class}>
    <div class="w-full">
    <.home_grid_header> Recent non-fiction </.home_grid_header>
      <div class="space-y-3">
        <%= for post <- @posts do %>
          <.content_item href={~p"/posts/#{post.slug}"} title={post.title} />
        <% end %>
      </div>
      <.view_all href={~p"/posts"} label="View all posts" />
    </div>
  </section>

  <section class={section_class}>Other short stories</section>
  <section class={section_class}>Recent areas of interest</section>
  <section class={section_class}>
    <div class="w-full">
    <.home_grid_header> Now </.home_grid_header>
      <a href={~p"/now/#{@update.slug}"} class="hover:opacity-50 transition-opacity text-sm block mb-3">
        <div class="mb-3"> <%= @update.title %></div>
      <div class="relative max-h-32 overflow-hidden text-sm" style="mask-image: linear-gradient(to bottom, black 20%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 20%, transparent 100%);">
        <%= truncate_html(@update.html, 500) %>
      </div>
      </a>
      <.view_all href={~p"/now"} label="View previous updates" />
    </div>
  </section>
</div>

<%!--
<.page_container class="max-w-xl mx-auto px-6 py-24 space-y-20">
  <header>
  </header>

  <section>
    <p class="text-xs uppercase tracking-widest opacity-50 mb-6">Writing</p>
    <div class="space-y-3">
      <%= for post <- @posts do %>
        <div class="flex justify-between items-baseline gap-6">
          <a href={~p"/posts/#{post.slug}"} class="hover:opacity-50 transition-opacity text-sm">
            <%= post.title %>
          </a>
          <time class="text-xs opacity-50 tabular-nums flex-shrink-0">
            <%= if post.published_at, do: Calendar.strftime(post.published_at, "%Y-%m-%d") %>
          </time>
        </div>
      <% end %>
    </div>
    <div class="mt-5">
      <a href={~p"/posts"} class="text-xs opacity-50 hover:opacity-60 transition-opacity">
        all posts →
      </a>
    </div>
  </section>

  <%= if @currently_reading do %>
    <section>
      <p class="text-xs uppercase tracking-widest opacity-50 mb-6">Currently Reading</p>
      <div class="flex items-start gap-4">
        <%= if @currently_reading.thumbnail_url do %>
          <img
            src={@currently_reading.thumbnail_url}
            alt={@currently_reading.title}
            class="w-12 flex-shrink-0 rounded shadow-sm"
          />
        <% end %>
        <div>
          <p class="text-sm"><%= @currently_reading.title %></p>
          <%= if @currently_reading.creator do %>
            <p class="text-xs opacity-40 mt-1"><%= @currently_reading.creator %></p>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <section>
    <p class="text-xs uppercase tracking-widest opacity-50 mb-6">Short Stories</p>
    <div class="space-y-3">
    </div>
    <div class="mt-5">
      <a href={~p"/til"} class="text-xs opacity-50 hover:opacity-60 transition-opacity">
        all →
      </a>
    </div>
  </section>
</.page_container>
--%>
