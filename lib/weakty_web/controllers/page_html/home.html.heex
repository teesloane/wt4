<Layouts.flash_group flash={@flash} />

<% section_class = "w-full  mx-auto min-h-[45vh] p-8 px-12 flex flex-col justify-center border border-base-300" %>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 gap-0 flex flex-col max-w-[2560px] mx-auto">
  <section class={[section_class, "md:text-xl lg:text-2xl"]}>
  Hello, my name is Ty.
  
  <div class="mt-8 text-content-200 opacity-50">
    This is where I write and share my work.
  </div>
  </section>

  <%!--

  <section class={section_class}>Some things I've made:</section>
  --%>

  <section class={section_class}>
    <div class="w-full">
      <.home_grid_header> The latest story I wrote is: </.home_grid_header>
      <%= if @recent_fiction do %>
        <.content_item
        href={~p"/posts/#{@recent_fiction.slug}"}
        size="xl"
        title={@recent_fiction.title} />
      <% else %>
        <p class="text-base-content/40 text-sm">No fiction yet</p>
      <% end %>
      <.view_all href={~p"/fiction"} label="View other stories" />
    </div>
  </section>
  <section class={section_class}>
    <div class="w-full">
      <.home_grid_header> Currently reading: </.home_grid_header>
      <%= if Enum.empty?(@currently_reading) do %>
        <p class="text-base-content/40 text-sm">Nothing at the moment</p>
      <% else %>
        <div class="space-y-3">
          <%= for book <- @currently_reading do %>
            <div>
              <div class="text-sm"><%= book.title %></div>
              <%= if book.creator do %>
                <div class="text-xs opacity-40 mt-0.5"><%= book.creator %></div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
      <.view_all href={~p"/media-logs?type=book&status=all&year=all"} label="View the media log" />
    </div>
  </section>

  <section class={section_class}>
    <div class="w-full">
    <.home_grid_header> Recent non-fiction </.home_grid_header>
      <div class="space-y-3">
        <%= for post <- @posts do %>
          <.content_item href={~p"/posts/#{post.slug}"} title={post.title} />
        <% end %>
      </div>
      <.view_all href={~p"/posts"} label="View all posts" />
    </div>
  </section>

  <%!-- Quote section
  <section class={section_class}>
    <%= if @random_quote do %>
      <span class="text-[50px]">“</span>
      <blockquote class="space-y-4 -mt-8">
        <span class="text-sm opacity-80"><%= @random_quote.markdown %></span>
        <%= if @random_quote.attribution do %>
          <footer class="text-xs opacity-40">
            <%= if @random_quote.attribution_url do %>
              <a href={@random_quote.attribution_url} class="hover:opacity-70 transition-opacity">— <%= @random_quote.attribution %></a>
            <% else %>
              — <%= @random_quote.attribution %>
            <% end %>
          </footer>
        <% end %>
      </blockquote>
    <% end %>
  </section>
  --%>

  <section class={section_class}>
    <div class="w-full">
      <.home_grid_header> Areas of interest </.home_grid_header>
      <div class="space-y-3">
        <%= for area <- @top_areas do %>
          <div class="flex items-baseline gap-3">
            <a href={~p"/areas/#{area.slug}"} class="flex-1 text-sm hover:opacity-50 transition-opacity">
              <%= area.name %>
            </a>
            <span class="text-xs opacity-30 tabular-nums">[<%= area.count %>]</span>
          </div>
        <% end %>
      </div>
      <.view_all href={~p"/areas"} label="View all areas" />
    </div>
  </section>
  <section class={section_class}>
    <div class="w-full">
    <.home_grid_header> Now </.home_grid_header>
      <a href={~p"/now/#{@update.slug}"} class="hover:opacity-50 transition-opacity text-sm block mb-3">
        <div class="mb-3"> <%= @update.title %></div>
      <div class="flex flex-col relative max-h-32 overflow-hidden text-sm whitespace-pre-line" style="mask-image: linear-gradient(to bottom, black 20%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 20%, transparent 100%);">
        <%= truncate_html(@update.html, 500) %>
      </div>
      </a>
      <.view_all href={~p"/now"} label="View previous updates" />
    </div>
  </section>
  <section class={[section_class, "hidden lg:flex xl:hidden"]}>Thank you.</section>
</div>

<%!--
<.page_container class="max-w-xl mx-auto px-6 py-24 space-y-20">
  <header>
  </header>

  <section>
    <p class="text-xs uppercase tracking-widest opacity-50 mb-6">Writing</p>
    <div class="space-y-3">
      <%= for post <- @posts do %>
        <div class="flex justify-between items-baseline gap-6">
          <a href={~p"/posts/#{post.slug}"} class="hover:opacity-50 transition-opacity text-sm">
            <%= post.title %>
          </a>
          <time class="text-xs opacity-50 tabular-nums flex-shrink-0">
            <%= if post.published_at, do: Calendar.strftime(post.published_at, "%Y-%m-%d") %>
          </time>
        </div>
      <% end %>
    </div>
    <div class="mt-5">
      <a href={~p"/posts"} class="text-xs opacity-50 hover:opacity-60 transition-opacity">
        all posts →
      </a>
    </div>
  </section>

  <%= if @currently_reading do %>
    <section>
      <p class="text-xs uppercase tracking-widest opacity-50 mb-6">Currently Reading</p>
      <div class="flex items-start gap-4">
        <%= if @currently_reading.thumbnail_url do %>
          <img
            src={@currently_reading.thumbnail_url}
            alt={@currently_reading.title}
            class="w-12 flex-shrink-0 rounded shadow-sm"
          />
        <% end %>
        <div>
          <p class="text-sm"><%= @currently_reading.title %></p>
          <%= if @currently_reading.creator do %>
            <p class="text-xs opacity-40 mt-1"><%= @currently_reading.creator %></p>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <section>
    <p class="text-xs uppercase tracking-widest opacity-50 mb-6">Short Stories</p>
    <div class="space-y-3">
    </div>
    <div class="mt-5">
      <a href={~p"/til"} class="text-xs opacity-50 hover:opacity-60 transition-opacity">
        all →
      </a>
    </div>
  </section>
</.page_container>
--%>
