<Layouts.flash_group flash={@flash} />

<% section_class =
  "w-full  mx-auto min-h-[45vh] p-8 px-12 flex flex-col justify-center border border-base-300" %>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 gap-0 flex flex-col max-w-[2560px] mx-auto">
  <section class={[section_class]}>
    <div class="md:text-xl lg:text-2xl">
    Hello, my name is Ty.
    </div>
    <div class="mt-8 text-content-200 opacity-50 md:text-base lg:text-lg">
      This is where I write and share my work.
    </div>
  </section>

  <%!--

  <section class={section_class}>Some things I've made:</section>
  --%>

  <section class={section_class}>
    <div class="w-full">
      <.home_grid_header>The latest story I wrote is:</.home_grid_header>
      <%= if @recent_fiction do %>
        <.content_item
          href={~p"/posts/#{@recent_fiction.slug}"}
          size="xl"
          title={@recent_fiction.title}
        />
      <% else %>
        <p class="text-base-content/40 text-sm">No fiction yet</p>
      <% end %>
      <.view_all href={~p"/fiction"} label="View other stories" />
    </div>
  </section>
  <section class={section_class}>
    <div class="w-full">
      <.home_grid_header>Currently reading:</.home_grid_header>
      <%= if Enum.empty?(@currently_reading) do %>
        <p class="text-base-content/40 text-sm">Nothing at the moment</p>
      <% else %>
        <div class="space-y-3">
          <%= for book <- @currently_reading do %>
            <div>
              <div class="text-sm">{book.title}</div>
              <%= if book.creator do %>
                <div class="text-xs opacity-40 mt-0.5">{book.creator}</div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
      <.view_all href={~p"/media-logs?type=book&status=all&year=all"} label="View the media log" />
    </div>
  </section>

  <section class={section_class}>
    <div class="w-full">
      <.home_grid_header>Recent non-fiction</.home_grid_header>
      <div class="space-y-3">
        <%= for post <- @posts do %>
          <.content_item href={~p"/posts/#{post.slug}"} title={post.title} />
        <% end %>
      </div>
      <.view_all href={~p"/posts"} label="View all posts" />
    </div>
  </section>

  <section class={section_class}>
    <div class="w-full">
      <.home_grid_header>Projects & Experiments</.home_grid_header>
      <%= if Enum.empty?(@projects) do %>
        <p class="text-base-content/40 text-sm">No projects yet</p>
      <% else %>
        <div class="space-y-3">
          <%= for project <- @projects do %>
            <.content_item
              href={~p"/projects/#{project.slug}"}
              title={project.title}
            />
          <% end %>
        </div>
      <% end %>
      <.view_all href={~p"/projects"} label="View all projects" />
    </div>
  </section>

  <section :if={@update} class={section_class}>
    <div class="w-full">
      <.home_grid_header>Now</.home_grid_header>
      <a
        href={~p"/now/#{@update.slug}"}
        class="hover:opacity-50 transition-opacity text-sm block mb-3"
      >
        <div class="mb-3">{@update.title}</div>
        <div
          class="flex flex-col relative max-h-32 overflow-hidden text-sm whitespace-pre-line"
          style="mask-image: linear-gradient(to bottom, black 20%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 20%, transparent 100%);"
        >
          {truncate_html(@update.html, 500)}
        </div>
      </a>
      <.view_all href={~p"/now"} label="View previous updates" />
    </div>
  </section>
</div>

<div class="min-h-[4vh] flex flex-col md:flex-row px-12 py-8 md:py-2 space-x-3 text-sm  md:items-center items-start">
  <.home_grid_header class="md:!mb-0">Areas of interest:</.home_grid_header>
  <%= for area <- @top_areas do %>
    <div class="flex items-baseline gap-1 mr-4">
      <a href={~p"/areas/#{area.slug}"} class="flex-1 text-sm hover:opacity-100 transition-opacity">
        {area.name}
      </a>
      <span class="text-xs opacity-50 tabular-nums">[{area.count}]</span>
    </div>
  <% end %>

  <.view_all class="md:!mt-0" href={~p"/areas"} label="View all areas" />
</div>
