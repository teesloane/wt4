<Layouts.flash_group flash={@flash} />

<div class="relative w-full h-screen">
  <img src={~p"/images/woods.webp"} alt="" class="absolute inset-0 w-full h-full object-cover" />
  <div class="absolute inset-0 bg-black/40" />
  <div class="absolute inset-0 flex flex-col items-start justify-center p-8  pb-32 max-w-7xl mx-auto">
    <div class="text-white text-2xl md:text-3xl lg:text-4xl">Hello, my name is Ty.</div>
    <div class="text-white/70 mt-4 text-base md:text-lg">This is where I write and share my work.</div>
    <div class="text-white/40 text-base md:text-lg">(That's me in the woods, at peace.)</div>
    <%= if @latest_story do %>
      <div class="mt-10 text-white/70 text-xs uppercase tracking-widest">Latest short story</div>
      <a href={~p"/posts/#{@latest_story.slug}"} class="mt-2 text-white text-lg md:text-xl hover:text-white/70 transition-colors">
        {@latest_story.title}
      </a>
    <% end %>
  </div>
</div>

<% section_class =
  "w-full mx-auto min-h-[360px] p-12 px-16 flex flex-col justify-center  border border-base-300" %>


<main class="max-w-[2500px] mx-auto  pb-24">
  
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3">

  <section class={section_class}>
    <div class="w-full">
      <.home_grid_header>About This Site</.home_grid_header>
      <div class="space-y-3 text-base">
      <p>This site is a catalogue of the creative projects and interests I explore in my free time, usually taking the form of non/fiction writing, programming, music, and visuals & design.
      Everything on this site was made by me, unless stated otherwise.
      </p>
      <p>Thank you for visiting and
      <a href="mailto:weakty@fastmail.com" class="text-base-content/70 border-b border-bg-base-100/0 hover:border-bg-base-100/100  hover:text-base-content/100 transition-all">don't hesitate to say hi.</a>
      </p>
      </div>
    </div>
  </section>

  <section class={section_class}>
    <div class="w-full">
      <.home_grid_header>Recent fiction</.home_grid_header>
      <div class="space-y-3">
        <%= for post <- @recent_fiction do %>
          <.content_item href={~p"/posts/#{post.slug}"} title={post.title} />
        <% end %>
      </div>
      <.view_all href={~p"/fiction"} label="View all fiction" />
    </div>
  </section>


  <section class={section_class}>
    <div class="w-full">
      <.home_grid_header>Recent non-fiction</.home_grid_header>
      <div class="space-y-3">
        <%= for post <- @posts do %>
          <.content_item href={~p"/posts/#{post.slug}"} title={post.title} />
        <% end %>
      </div>
      <.view_all href={~p"/posts"} label="View all posts" />
    </div>
  </section>

  <section class={section_class}>
    <div class="w-full">
      <.home_grid_header>Projects & Experiments</.home_grid_header>
      <%= if Enum.empty?(@projects) do %>
        <p class="text-base-content/40 text-base">No projects yet</p>
      <% else %>
        <div class="space-y-3">
          <%= for project <- @projects do %>
            <.content_item
              href={~p"/projects/#{project.slug}"}
              title={project.title}
            />
          <% end %>
        </div>
      <% end %>
      <.view_all href={~p"/projects"} label="View all projects" />
    </div>
  </section>

  <section class={section_class}>
    <div class="w-full">
      <.home_grid_header>Currently reading:</.home_grid_header>
      <%= if Enum.empty?(@currently_reading) do %>
        <p class="text-base-content/40 text-base">Nothing at the moment</p>
      <% else %>
        <div class="space-y-3">
          <%= for book <- @currently_reading do %>
            <div>
              <div class="text-base">{book.title}</div>
              <%= if book.creator do %>
                <div class="text-xs opacity-40 mt-0.5">{book.creator}</div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
      <.view_all href={~p"/media-logs?type=book&status=all&year=all"} label="View the media log" />
    </div>
  </section>


  <section :if={@update} class={section_class}>
    <div class="w-full">
      <.home_grid_header>Now</.home_grid_header>
      <a
        href={~p"/now/#{@update.slug}"}
        class="hover:opacity-50 transition-opacity text-base block mb-3"
      >
        <div class="mb-3">{@update.title}</div>
        <div
          class="flex flex-col relative max-h-48 overflow-hidden text-base whitespace-pre-line"
          style="mask-image: linear-gradient(to bottom, black 20%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 20%, transparent 100%);"
        >
          {truncate_html(@update.html, 500)}
        </div>
      </a>
      <.view_all href={~p"/now"} label="View previous updates" />
    </div>
  </section>
</div>

<div class="min-h-[4vh] flex flex-col md:flex-row  py-8 md:py-2 space-x-3 text-base  md:items-center items-start my-16 justify-center max-w-7xl mx-auto">
  <.home_grid_header class="md:!mb-0">Areas of interest:</.home_grid_header>
  <%= for area <- @top_areas do %>
    <div class="flex items-baseline gap-1 mr-4">
      <a href={~p"/areas/#{area.slug}"} class="flex-1 text-base hover:opacity-100 transition-opacity">
        {area.name}
      </a>
      <span class="text-xs opacity-50 tabular-nums">[{area.count}]</span>
    </div>
  <% end %>

  <.view_all class="md:!mt-0" href={~p"/areas"} label="View all areas" />
</div>
</main>
